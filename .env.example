# Next.js proxies /api/* to this. The engine refuses anything but localhost.
ENGINE_URL=http://127.0.0.1:8790

# A Vercel KV or Upstash database shares one list between your devices and
# holds the reminder sign-ups. Without it, each browser keeps its own copy.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Four digits, required once the database is connected.
# DAYMARK_PASSCODE=

# How long a device stays unlocked before Daymark asks for the passcode again.
# 24 when unset. 0 asks every time Daymark is opened.
# DAYMARK_UNLOCK_HOURS=24

# Vercel and QStash send this to the reminder job so nobody else can start it.
# CRON_SECRET=

# Optional. Upstash QStash wakes the reminder job at each reminder's time.
# Without it, a closed Daymark gets reminders once a day, around 9 AM.
# QSTASH_TOKEN=
